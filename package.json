{
  "name": "kuaishou-downloader",
  "version": "1.0.0",
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "scripts": {
    "start": "node scripts/cli/download.mjs",
    "test": "node --test",
    "ui": "node server.js",
    "ui:threads": "node server.js --port=3001 --threads-only",
    "ui:tiktok": "node server.js --port=3003 --tiktok-only",
    "render:tiktok": "node scripts/cli/render-tiktok-sample.mjs",
    "ui:all": "node server.js --port=3002",
    "test:threads-api": "node scripts/checks/verify-threads-api.mjs",
    "test:ui": "node scripts/checks/verify-studio-ui.mjs",
    "ig:login": "node src/platforms/instagram/poster.js login",
    "tiktok:login": "node src/platforms/tiktok/poster.js login",
    "threads:login": "node src/platforms/threads/poster.js login",
    "ui:x": "node server.js --port=3004 --x-only",
    "test:x-ui": "node scripts/checks/verify-x-ui.mjs"
  },
  "dependencies": {
    "playwright": "^1.63.0",
    "twitter-text": "^3.1.0"
  }
}
